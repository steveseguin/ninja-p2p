{
  "name": "@vdoninja/ninja-p2p",
  "version": "0.2.4",
  "description": "Agent coordination and file handoffs over WebRTC or HTTP, with persistent inboxes, hosted agent mailboxes, wake hooks, resumable file swarms, and an optional Social Stream bridge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ninja-p2p-call": "./runtime/call-server.mjs",
    "ninja-p2p": "./dist/cli.js",
    "ninja-p2p-relay": "./runtime/relay-server.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vdo-bridge": {
      "types": "./dist/vdo-bridge.d.ts",
      "import": "./dist/vdo-bridge.js"
    },
    "./message-bus": {
      "types": "./dist/message-bus.d.ts",
      "import": "./dist/message-bus.js"
    },
    "./peer-registry": {
      "types": "./dist/peer-registry.d.ts",
      "import": "./dist/peer-registry.js"
    },
    "./file-transfer": {
      "types": "./dist/file-transfer.d.ts",
      "import": "./dist/file-transfer.js"
    },
    "./agent-state": {
      "types": "./dist/agent-state.d.ts",
      "import": "./dist/agent-state.js"
    },
    "./shared-folders": {
      "types": "./dist/shared-folders.d.ts",
      "import": "./dist/shared-folders.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./dashboard.html": "./dashboard.html",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "runtime",
    "mailbox-service/*.mjs",
    "mailbox-service/package.json",
    "mailbox-service/package-lock.json",
    "mailbox-service/*.py",
    "mailbox-service/*.service",
    "mailbox-service/README.md",
    "dashboard.html",
    "README.md",
    "CHANGELOG.md",
    "docs/images/agent-room-dashboard.png",
    "docs/protocol-and-reliability.md",
    "docs/security.md",
    "docs/social-stream-bridge.md",
    "docs/sdk-wishlist.md",
    "docs/operations.md",
    "docs/releases.md",
    "docs/recovery-validation.md",
    "docs/north-star.md",
    "docs/cloud-connections.md",
    "docs/tasks.md",
    "docs/workers.md",
    "docs/voice-and-vision.md",
    ".codex/skills/ninja-p2p",
    ".agents/skills/ninja-p2p",
    ".claude/skills/ninja-p2p"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "npm test && npm run build",
    "validate:live": "node ./scripts/validate-live.mjs",
    "validate:swarm": "node ./scripts/validate-swarm-live.mjs",
    "sync:docs": "node scripts/build-site.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "vdo.ninja",
    "agent",
    "agent-mesh",
    "cli",
    "codex",
    "claude-code",
    "skill",
    "pub-sub",
    "data-channel",
    "bot",
    "nat-traversal",
    "hole-punching",
    "file-transfer",
    "swarm",
    "wake-hook",
    "social-stream",
    "ai-agents",
    "agent-coordination",
    "resumable-transfer"
  ],
  "author": "Steve Seguin",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveseguin/ninja-p2p.git"
  },
  "bugs": {
    "url": "https://github.com/steveseguin/ninja-p2p/issues"
  },
  "homepage": "https://steveseguin.github.io/ninja-p2p/",
  "dependencies": {
    "@vdoninja/sdk": "^1.5.4",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "^0.8.0",
    "node-datachannel": "^0.32.3"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
    "node-datachannel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "marked": "^14.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
